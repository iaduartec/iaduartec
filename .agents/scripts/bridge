#!/usr/bin/env bash
# Project Bridge common launcher.
# Usage: bridge {serve|mcp|status|handoffs|handoff ID|json-status|auto-record|agy-preinvocation|agy-stop|version|doctor}
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"
ROOT="$(bridge_root)"
export PROJECT_BRIDGE_ROOT="$ROOT"
cmd="${1:-status}"
shift || true
case "$cmd" in
  serve|mcp)
    exec python3 "$ROOT/.agents/project-bridge/server.py" ;;
  doctor)
    exec "$SCRIPT_DIR/doctor" ;;
  status|handoffs|handoff|json-status|auto-record|agy-preinvocation|agy-stop|version|agy-project-name|agy-ensure-binding)
    exec python3 "$ROOT/.agents/project-bridge/bridge.py" "$cmd" "$@" ;;
  *)
    echo "usage: bridge {serve|mcp|status|handoffs|handoff ID|json-status|auto-record|agy-preinvocation|agy-stop|version|doctor}" >&2
    exit 2 ;;
esac
