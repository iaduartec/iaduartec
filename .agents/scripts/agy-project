#!/usr/bin/env bash
# Transparent AGY launcher: binds the repo to an AGY project so workspace
# customizations (hooks + plugin MCP) load, then runs agy with all args intact.
#
#   agy-project [args...]            # ensure binding, then `agy --project <name> ...`
#   agy-project --no-bind [args...]  # skip auto-binding (use an existing project)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"
ROOT="$(bridge_root)"
export PROJECT_BRIDGE_ROOT="$ROOT"
BRIDGE_PY="$ROOT/.agents/project-bridge/bridge.py"

if ! command -v agy >/dev/null 2>&1; then
  echo "agy-project: 'agy' not found on PATH" >&2
  exit 127
fi

NO_BIND=0
ARGS=()
for a in "$@"; do
  if [[ "$a" == "--no-bind" ]]; then
    NO_BIND=1
  else
    ARGS+=("$a")
  fi
done

NAME="$(python3 "$BRIDGE_PY" agy-project-name)"
if [[ "$NO_BIND" == "0" ]]; then
  python3 "$BRIDGE_PY" agy-ensure-binding "$NAME" >/dev/null 2>&1 || true
fi
exec agy --project "$NAME" ${ARGS[@]+"${ARGS[@]}"}
